[Unit]
Description=Garage S3-compatible object storage (single-node)
Documentation=https://garagehq.deuxfleurs.fr/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garage
Group=garage
ExecStart={{GARAGE_BIN_PATH}} server --single-node
Environment=GARAGE_CONFIG_FILE={{GARAGE_CONFIG_PATH}}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# Data dirs must be owned by garage:garage
ReadWritePaths={{GARAGE_READWRITE_PATHS}}

[Install]
WantedBy=multi-user.target
