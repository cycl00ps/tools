# Pinned component versions — bump deliberately, then re-run prepare + compose pull.
# Agents: do not float to "latest".

GARAGE_VERSION=v2.4.1
GARAGE_ARCH=x86_64-unknown-linux-musl
GARAGE_DOWNLOAD_URL=https://garagehq.deuxfleurs.fr/_releases/${GARAGE_VERSION}/${GARAGE_ARCH}/garage

# Docker Hardened Images — Harbor 2.15.x family
HARBOR_DHI_TAG=2.15.2-debian13
NGINX_DHI_TAG=1.31.3-debian13

HARBOR_CORE_IMAGE=dhi.io/harbor-core:${HARBOR_DHI_TAG}
HARBOR_PORTAL_IMAGE=dhi.io/harbor-portal:${HARBOR_DHI_TAG}
HARBOR_JOBSERVICE_IMAGE=dhi.io/harbor-jobservice:${HARBOR_DHI_TAG}
HARBOR_REGISTRY_IMAGE=dhi.io/harbor-registry:${HARBOR_DHI_TAG}
HARBOR_REGISTRYCTL_IMAGE=dhi.io/harbor-registryctl:${HARBOR_DHI_TAG}
HARBOR_TRIVY_IMAGE=dhi.io/harbor-trivy-adapter:${HARBOR_DHI_TAG}
HARBOR_EXPORTER_IMAGE=dhi.io/harbor-exporter:${HARBOR_DHI_TAG}
HARBOR_DB_IMAGE=dhi.io/harbor-db:${HARBOR_DHI_TAG}
HARBOR_REDIS_IMAGE=dhi.io/harbor-redis:${HARBOR_DHI_TAG}
NGINX_IMAGE=dhi.io/nginx:${NGINX_DHI_TAG}
