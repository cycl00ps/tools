# Copy to .env and edit before deploy:
#   cp .env.example .env
#
# Never commit .env.

# --- Public Harbor identity ---
# FQDN or IP clients will use (must match TLS SAN / docker login host)
HARBOR_HOSTNAME=registry.example.local
# Must match how browsers/clients reach Harbor (scheme + host [+ port if non-default])
HARBOR_EXTERNAL_URL=https://registry.example.local
HARBOR_ADMIN_PASSWORD=ChangeMeAdminPass!

# Published host ports
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL (Harbor DB) ---
POSTGRES_PASSWORD=ChangeMeDbPass!

# --- Garage (filled by garage/install.sh + garage/bootstrap.sh if left empty) ---
GARAGE_META_DIR=/var/lib/garage/meta
GARAGE_DATA_DIR=/var/lib/garage/data
# Address Garage advertises for RPC (use this host's LAN IP in multi-interface setups)
GARAGE_RPC_PUBLIC_ADDR=127.0.0.1:3901
# Leave empty to auto-generate on install:
# GARAGE_RPC_SECRET=
# GARAGE_ADMIN_TOKEN=

GARAGE_BUCKET=harbor-images
GARAGE_KEY_NAME=harbor-registry
# Leave empty until bootstrap.sh creates them:
# GARAGE_ACCESS_KEY=
# GARAGE_SECRET_KEY=

# How Harbor containers reach Garage S3 API.
# On Linux Docker 20.10+, host.docker.internal is provided via compose extra_hosts.
GARAGE_S3_ENDPOINT=http://host.docker.internal:3900

# --- Optional overrides (auto-generated by harbor/prepare.sh if unset) ---
# CORE_SECRET=
# JOBSERVICE_SECRET=
# CSRF_KEY=
# HARBOR_SECRET_KEY=
# REGISTRY_CREDENTIAL_USERNAME=harbor_registry_user
# REGISTRY_CREDENTIAL_PASSWORD=
