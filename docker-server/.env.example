# Copy to .env and edit before deploy:
#   cp .env.example .env
#
# Never commit .env.

# --- Public Harbor identity ---
# FQDN or IP clients will use (must match TLS SAN / docker login host)
HARBOR_HOSTNAME=registry.example.local
# Must match how browsers/clients reach Harbor (scheme + host [+ port if non-default]).
#
# Lab without a trusted TLS cert (direct to Harbor):
#   HARBOR_EXTERNAL_URL=http://HOSTNAME:HTTP_PORT
#   (Harbor clears CSRF "Secure" cookies when EXT_ENDPOINT starts with http://)
#
# Behind Caddy/other TLS terminator (NGINX_ENABLE_HTTPS=false):
#   HARBOR_EXTERNAL_URL=https://HOSTNAME
#   (use the public HTTPS URL so Secure cookies stay correct)
HARBOR_EXTERNAL_URL=https://registry.example.local
HARBOR_ADMIN_PASSWORD=ChangeMeAdminPass!

# --- Edge proxy (Harbor nginx in Compose) ---
# true  = publish HTTP + HTTPS (self-signed certs from harbor/prepare.sh)
# false = HTTP only — use when Caddy/another proxy terminates TLS in front
NGINX_ENABLE_HTTPS=true
# Published host ports (change if 80/443 are already in use)
# If you change these, put the same port in HARBOR_EXTERNAL_URL when clients hit Harbor directly.
HTTP_PORT=80
HTTPS_PORT=443
# Bind address for the HTTP publish. Use 127.0.0.1 behind Caddy.
PROXY_HTTP_BIND=0.0.0.0

# --- Harbor bind-mount root (DB, redis, core, job logs, trivy cache) ---
# Empty = <repo>/data/harbor. Absolute path recommended if relocating.
# Changing this after first deploy does not migrate existing data.
# HARBOR_DATA_DIR=

# --- PostgreSQL (Harbor DB) ---
POSTGRES_PASSWORD=ChangeMeDbPass!

# --- Garage (filled by garage/install.sh + garage/bootstrap.sh if left empty) ---
GARAGE_META_DIR=/var/lib/garage/meta
GARAGE_DATA_DIR=/var/lib/garage/data
GARAGE_BIN_PATH=/usr/local/bin/garage
GARAGE_CONFIG_PATH=/etc/garage.toml
# Address Garage advertises for RPC (use this host's LAN IP in multi-interface setups)
GARAGE_RPC_PUBLIC_ADDR=127.0.0.1:3901
# Leave empty to auto-generate on install:
# GARAGE_RPC_SECRET=
# GARAGE_ADMIN_TOKEN=

GARAGE_BUCKET=harbor-images
GARAGE_KEY_NAME=harbor-registry
# Leave empty until bootstrap.sh creates them:
# GARAGE_ACCESS_KEY=
# GARAGE_SECRET_KEY=

# How Harbor containers reach Garage S3 API.
# Prefer the host LAN IP (works with rootless Docker). host.docker.internal often
# fails under rootless (connection refused to the bridge gateway).
# Example: GARAGE_S3_ENDPOINT=http://192.168.200.209:3900
GARAGE_S3_ENDPOINT=http://HOST_LAN_IP:3900

# --- Optional overrides (auto-generated by harbor/prepare.sh if unset) ---
# CORE_SECRET=
# JOBSERVICE_SECRET=
# CSRF_KEY=
# HARBOR_SECRET_KEY=
# REGISTRY_CREDENTIAL_USERNAME=harbor_registry_user
# REGISTRY_CREDENTIAL_PASSWORD=
